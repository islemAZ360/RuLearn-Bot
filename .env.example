# Firebase Admin SDK Configuration
# للحصول على Service Account:
# 1. افتح Firebase Console > Project Settings > Service accounts
# 2. انقر Generate new private key
# 3. انسخ محتوى JSON وضعه في FIREBASE_SERVICE_ACCOUNT في ملف .env محلي

FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"YOUR_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"YOUR_CLIENT_ID"}'

# Webhook Configuration
WEBHOOK_URL=https://ru-learn-bot.vercel.app/api/webhook
